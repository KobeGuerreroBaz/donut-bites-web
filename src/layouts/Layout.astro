---
interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  image?: string;
  imageAlt?: string;
  phone?: string;
  noindex?: boolean;
}

const {
  title = "Donas Personalizadas en Monterrey y Eventos | Donut Bites",
  description = "Donas decoradas artesanales para eventos, regalos y cumpleaños en Monterrey. Diseños exclusivos sobre pedido con entrega a domicilio. ¡Cotiza por WhatsApp!",
  ogTitle = "Donas Personalizadas y Decoradas en Monterrey | Donut Bites",
  ogDescription = "Sorprende en tus eventos y fechas especiales con donas decoradas artesanales. Envíos a domicilio en Monterrey y zona metropolitana.",
  image = "/images/library/general/catalogo-donas-decoradas-monterrey.jpeg",
  imageAlt = "Donas decoradas artesanales de Donut Bites en Monterrey",
  phone,
  noindex = false,
} = Astro.props;

const siteUrl = "https://donutbitesco.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const absImage = image.startsWith("http") ? image : `${siteUrl}${image}`;
const telephone = phone ? `+${phone}` : undefined;

const cities = [
  "Monterrey", "San Pedro Garza García", "San Nicolás de los Garza",
  "Guadalupe", "Apodaca", "General Escobedo", "Santa Catarina", "Juárez",
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Bakery",
      "@id": `${siteUrl}/#negocio`,
      "name": "Donut Bites",
      "alternateName": "Donut Bites.co",
      "description": "Donas decoradas artesanales por encargo para eventos, regalos y cumpleaños en Monterrey y su área metropolitana, con entrega a domicilio.",
      "url": siteUrl,
      "image": absImage,
      ...(telephone ? { "telephone": telephone } : {}),
      "priceRange": "$$",
      "servesCuisine": "Donas decoradas artesanales",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Monterrey",
        "addressRegion": "Nuevo León",
        "addressCountry": "MX",
      },
      "areaServed": cities.map((name) => ({ "@type": "City", "name": name })),
      "sameAs": [
        "https://www.facebook.com/donutbitesco",
        "https://www.instagram.com/donut.bites.co",
        "https://www.tiktok.com/@donut.bites85",
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        ...(telephone ? { "telephone": telephone } : {}),
        "availableLanguage": "Spanish",
      },
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Donut Bites",
      "inLanguage": "es-MX",
      "publisher": { "@id": `${siteUrl}/#negocio` },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#E8496A" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />

  <!-- SEO Primary -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Donut Bites" />
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content={absImage} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:site_name" content="Donut Bites" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={absImage} />

  <!-- Fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org del negocio (sitio completo) -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- Schema u otros elementos propios de cada página -->
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>