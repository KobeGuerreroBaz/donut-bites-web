---
// src/components/WhatsAppButton.astro
import { whatsappUrl, MENSAJE_BASE } from '../lib/whatsapp';

interface Props {
  /** Mensaje prellenado. Cámbialo por página para saber de dónde viene el cliente. */
  message?: string;
  /** Número de WhatsApp (pásalo desde content.whatsappNumber). Si falta, usa el de respaldo. */
  number?: string;
  /** Texto del botón */
  label?: string;
  /** 'solid' (rosa) o 'outline' (borde rosa) */
  variant?: 'solid' | 'outline';
  /** Ocupa todo el ancho (útil en móvil) */
  full?: boolean;
  class?: string;
}

const {
  message = MENSAJE_BASE,
  number,
  label = 'Cotiza por WhatsApp',
  variant = 'solid',
  full = false,
  class: extraClass = '',
} = Astro.props;

const href = whatsappUrl(message, number);
---

<a
  class={`wa-btn wa-${variant} ${full ? 'wa-full' : ''} ${extraClass}`.trim()}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-wa-btn
>
  <svg class="wa-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M20.52 3.48A11.9 11.9 0 0 0 12.04 0C5.46 0 .12 5.34.12 11.92c0 2.1.55 4.15 1.6 5.96L0 24l6.3-1.65a11.9 11.9 0 0 0 5.74 1.46h.01c6.58 0 11.92-5.34 11.92-11.92 0-3.18-1.24-6.17-3.45-8.41ZM12.05 21.8h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.88 9.88 0 0 1-1.52-5.25c0-5.46 4.45-9.9 9.92-9.9 2.64 0 5.12 1.03 6.99 2.9a9.84 9.84 0 0 1 2.9 7c0 5.46-4.45 9.9-9.9 9.9Zm5.43-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35Z"
    ></path>
  </svg>
  <span>{label}</span>
</a>

<style>
  .wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 48px; /* zona táctil cómoda en móvil */
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    border: 2px solid var(--pink, #E8496A);
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    line-height: 1.1;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .wa-solid {
    background: var(--pink, #E8496A);
    color: #fff;
    box-shadow: 0 4px 14px rgba(232, 73, 106, 0.3);
  }
  .wa-outline {
    background: transparent;
    color: var(--pink, #E8496A);
  }
  .wa-btn:hover,
  .wa-btn:focus-visible {
    transform: translateY(-2px);
  }
  .wa-solid:hover,
  .wa-solid:focus-visible {
    box-shadow: 0 8px 20px rgba(232, 73, 106, 0.4);
  }
  .wa-outline:hover,
  .wa-outline:focus-visible {
    background: var(--pink, #E8496A);
    color: #fff;
  }
  .wa-btn:focus-visible {
    outline: 3px solid var(--gold, #F4A629);
    outline-offset: 3px;
  }
  .wa-full {
    display: flex;
    width: 100%;
  }
  .wa-icon {
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
  }
</style>
