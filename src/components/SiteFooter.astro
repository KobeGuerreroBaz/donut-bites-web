---
import { ICON } from '../lib/icons';
import { municipios, rutaMunicipio } from '../lib/municipios';
import { temporadas, rutaTemporada } from '../lib/temporadas';

interface Props {
  whatsappURL: string;
  social: { instagram: string; tiktok: string; facebook: string };
}

const { whatsappURL, social } = Astro.props;
const year = new Date().getFullYear();
---

<a href={whatsappURL} class="wapp-sticky" target="_blank" rel="noopener" aria-label="Contactar por WhatsApp">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON.wa} /></svg>
  <span>Pedir ahora</span>
</a>

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-logo">
      <span>🍩</span>
      <span>Donut<strong>Bites</strong>.co</span>
    </div>
    <p class="footer-tagline">Donas decoradas artesanales · Monterrey y Área Metropolitana</p>
    <nav class="footer-zonas" aria-label="Donas decoradas por municipio">
      <p class="footer-zonas-title">Donas decoradas en tu zona</p>
      <ul>
        {municipios.map((m) => (
          <li><a href={rutaMunicipio(m.slug)}>Donas decoradas en {m.nombre}</a></li>
        ))}
      </ul>
    </nav>
    <nav class="footer-zonas" aria-label="Donas decoradas por temporada">
      <p class="footer-zonas-title">Donas por temporada</p>
      <ul>
        {temporadas.map((t) => (
          <li><a href={rutaTemporada(t.slug)}>Donas decoradas para {t.nombre}</a></li>
        ))}
      </ul>
    </nav>
    <div class="footer-socials">
      <a href={social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON.ig} /></svg>
      </a>
      <a href={social.tiktok} target="_blank" rel="noopener" aria-label="TikTok">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON.tt} /></svg>
      </a>
      <a href={social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON.fb} /></svg>
      </a>
    </div>
    <p class="footer-copy">© {year} Donut Bites.co · Hecho con 🍩 en Monterrey, NL</p>
  </div>
</footer>

<style>
  .footer-zonas { margin-bottom: 28px; }
  .footer-zonas-title {
    font-size: .8rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .85);
    margin-bottom: 12px;
  }
  .footer-zonas ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 18px;
    max-width: 760px;
    margin: 0 auto;
  }
  .footer-zonas a {
    color: rgba(255, 255, 255, .65);
    font-size: .9rem;
    text-decoration: none;
    transition: color .2s;
  }
  .footer-zonas a:hover { color: var(--white); text-decoration: underline; }
</style>
