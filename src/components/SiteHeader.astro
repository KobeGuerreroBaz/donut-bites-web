---
// src/components/SiteHeader.astro
// Header con menú móvil. Úsalo en todas las páginas públicas.
//   <SiteHeader whatsappURL={url} home />   en la home (anclas #sabores, #ocasiones...)
//   <SiteHeader whatsappURL={url} />        en las demás páginas (anclas /#sabores...)
import '../styles/global.css';
import { ICON } from '../lib/icons';

interface Props {
  whatsappURL: string;
  home?: boolean;
}

const { whatsappURL, home = false } = Astro.props;
const base = home ? '' : '/';
---

<header class="header">
  <nav class="nav">
    <a href="/" class="logo" aria-label="Donut Bites, inicio">
      <span class="logo-icon">🍩</span>
      <span class="logo-text">Donut<strong>Bites</strong><span class="logo-co">.co</span></span>
    </a>
    <div class="nav-links">
      <a href={`${base}#sabores`}>Sabores</a>
      <a href={`${base}#ocasiones`}>Ocasiones</a>
      <a href={`${base}#nosotros`}>Nosotros</a>
      <a href={whatsappURL} class="btn-nav-wapp" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON.wa} /></svg>
        Pedir ahora
      </a>
    </div>
    <button class="hamburger" id="hamburger" aria-label="Menú" aria-expanded="false" aria-controls="mobileMenu">
      <span></span><span></span><span></span>
    </button>
  </nav>
  <div class="mobile-menu" id="mobileMenu">
    <a href={`${base}#sabores`}>Sabores</a>
    <a href={`${base}#ocasiones`}>Ocasiones</a>
    <a href={`${base}#nosotros`}>Nosotros</a>
    <a href={whatsappURL} target="_blank" rel="noopener">💬 Hacer pedido</a>
  </div>
</header>

<script is:inline>
  (function () {
    var ham = document.getElementById('hamburger');
    var menu = document.getElementById('mobileMenu');
    if (!ham || !menu) return;
    ham.addEventListener('click', function () {
      var open = menu.classList.toggle('open');
      ham.setAttribute('aria-expanded', String(!!open));
    });
    // Cualquier enlace del menú lo cierra
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        menu.classList.remove('open');
        ham.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>
