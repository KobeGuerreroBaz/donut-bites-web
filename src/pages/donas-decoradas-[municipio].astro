---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import FAQ from '../components/FAQ.astro';
import ResenasGoogle from '../components/ResenasGoogle.astro';
import { getContent, defaultContent } from '../lib/content';
import { faqPedidos } from '../lib/faq-pedidos';
import { municipios, otrosMunicipios, rutaMunicipio } from '../lib/municipios';
import { zonas, zonasDe } from '../lib/zonas';
import { whatsappUrl } from '../lib/whatsapp';
import { fotosParaMunicipio } from '../lib/fotos-locales';

const { municipio: slug } = Astro.params;
const municipioEncontrado = municipios.find((x) => x.slug === slug);
const zona = municipioEncontrado ? undefined : zonas.find((x) => x.slug === slug);
const m = municipioEncontrado ?? zona;

if (!m) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const env = Astro.locals.runtime?.env;
const content = env ? await getContent(env) : defaultContent;

const waNumber = content.whatsappNumber;
const waURL = whatsappUrl(m.mensajeWhatsApp, waNumber);

const faqItems = [...m.faq, ...faqPedidos.slice(0, 3)];

const padre = zona ? municipios.find((x) => x.slug === zona.municipio) : undefined;
const zonasHijas = zona ? [] : zonasDe(m.slug);
const zonasHermanas = zona ? zonasDe(zona.municipio).filter((z) => z.slug !== zona.slug) : [];

const otrasPaginas = zona && padre
  ? [padre, ...municipios.filter((x) => x.slug !== padre.slug)]
  : municipios.filter((x) => x.slug !== m.slug);
const sinPagina = zona ? [] : otrosMunicipios.filter((n) => {
  const nl = n.toLowerCase();
  const tienePagina = municipios.some((x) => nl.includes(x.nombre.toLowerCase()));
  return !tienePagina;
});

const indiceFotos = zona ? municipios.length + zonas.indexOf(zona) : municipios.indexOf(m);
const todas = fotosParaMunicipio(m.nombre, indiceFotos);

const badge = zona && padre ? `${m.nombre}, ${padre.nombre}` : `${m.nombre}, Nuevo León`;
const migas = zona && padre
  ? [{ name: padre.nombre, href: rutaMunicipio(padre.slug) }, { name: m.h1 }]
  : [{ name: m.h1 }];
const fotosHero = todas.slice(0, 4);
const fotos = todas.slice(4, 10);

const siteUrl = 'https://donutbitesco.com';
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Donas decoradas en ${m.nombre}`,
  serviceType: 'Donas decoradas artesanales',
  url: `${siteUrl}${rutaMunicipio(m.slug)}`,
  provider: { '@id': `${siteUrl}/#negocio` },
  areaServed: zona && padre
    ? {
        '@type': 'Place',
        name: `${m.nombre}, ${padre.nombre}`,
        containedInPlace: {
          '@type': 'City',
          name: padre.nombre,
          containedInPlace: { '@type': 'AdministrativeArea', name: 'Nuevo León' },
        },
      }
    : {
        '@type': 'City',
        name: m.nombre,
        containedInPlace: { '@type': 'AdministrativeArea', name: 'Nuevo León' },
      },
};
---

<Layout
  title={m.title}
  description={m.description}
  ogTitle={m.title}
  ogDescription={m.description}
  phone={waNumber}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <div class="site-wrapper">
    <SiteHeader whatsappURL={waURL} />

    <Breadcrumbs items={migas} />

    <main>
      <section class="local-hero">
        <div class="container local-hero-inner">
          <div class="hero-badge">📍 {badge}</div>
          <h1 class="local-title">{m.h1}</h1>
          <p class="local-intro">{m.intro}</p>
          <ul class="hero-strip">
            {fotosHero.map((f, i) => (
              <li class="hero-strip-item">
                <img
                  src={f.mini}
                  alt={f.alt}
                  width="320"
                  height="320"
                  loading="eager"
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  decoding="async"
                />
              </li>
            ))}
          </ul>
          <div class="local-ctas">
            <WhatsAppButton
              number={waNumber}
              message={m.mensajeWhatsApp}
              label="Cotizar por WhatsApp"
            />
            <a href="/#sabores" class="btn-secondary">Ver sabores</a>
          </div>
        </div>
      </section>

      <section class="local-section local-gallery">
        <div class="container">
          <div class="section-header">
            <span class="section-eyebrow">Hechas a mano</span>
            <h2>Así quedan nuestras donas decoradas</h2>
            <p>Cada pedido se diseña a tu medida. Aquí tienes algunos ejemplos para inspirarte.</p>
          </div>
          <ul class="gallery">
            {fotos.map((f) => (
              <li class="gallery-item">
                <img src={f.src} alt={f.alt} width="800" height="800" loading="lazy" decoding="async" />
              </li>
            ))}
          </ul>
          <div class="gallery-cta">
            <WhatsAppButton number={waNumber} message={m.mensajeWhatsApp} label="Quiero las mías" />
          </div>
        </div>
      </section>

      {zona?.colegio && (
        <section class="local-section local-colegio">
          <div class="container local-narrow">
            <div class="section-header">
              <span class="section-eyebrow">{zona.colegio.eyebrow}</span>
              <h2>{zona.colegio.titulo}</h2>
              <p>{zona.colegio.texto}</p>
            </div>
            <ul class="colegio-puntos">
              {zona.colegio.puntos.map((p) => <li>{p}</li>)}
            </ul>
            <div class="gallery-cta">
              <WhatsAppButton
                number={waNumber}
                message={zona.colegio.mensajeWhatsApp}
                label="Cotizar donas para el colegio"
              />
            </div>
          </div>
        </section>
      )}

      <ResenasGoogle max={3} compacta prioridad="entrega" title="Nuestros clientes opinan" />

      <section class="local-section">
        <div class="container local-narrow">
          <div class="section-header">
            <span class="section-eyebrow">Entrega a domicilio</span>
            <h2>Llegamos a tu puerta en {m.nombre}</h2>
            <p>{m.cobertura}</p>
          </div>

          {m.colonias.length > 0 && (
            <div class="chip-group">
              <p class="chip-title">Algunas de las colonias que atendemos</p>
              <ul class="chips">
                {m.colonias.map((c) => <li class="chip">{c}</li>)}
              </ul>
            </div>
          )}

          <div class="chip-group">
            <p class="chip-title">Zonas de referencia</p>
            <ul class="chips chips-soft">
              {m.referencias.map((r) => <li class="chip">{r}</li>)}
            </ul>
          </div>

          <p class="local-note">{m.nota}</p>
        </div>
      </section>

      <section class="local-section local-ideas">
        <div class="container local-narrow">
          <h2 class="local-ideas-title">{m.ideasTitulo}</h2>
          <p class="local-ideas-text">{m.ideasTexto}</p>
        </div>
      </section>

      <section class="local-section local-steps-bg">
        <div class="container">
          <div class="section-header">
            <span class="section-eyebrow">¿Cómo pedir?</span>
            <h2>Tu pedido en {m.nombre}, paso a paso</h2>
          </div>
          <div class="local-steps">
            <div class="local-step">
              <div class="local-step-icon">💬</div>
              <h3>1. Escríbenos</h3>
              <p>Cuéntanos tu idea, la fecha y la cantidad por WhatsApp. Pide con 3 días de anticipación y te cotizamos sin compromiso.</p>
            </div>
            <div class="local-step">
              <div class="local-step-icon">🎨</div>
              <h3>2. Diseñamos</h3>
              <p>Armamos el diseño de tus donas con el tema y los colores de tu evento, desde una caja de 6.</p>
            </div>
            <div class="local-step">
              <div class="local-step-icon">🛵</div>
              <h3>3. Las recibes</h3>
              <p>Te las llevamos a domicilio en {m.nombre}, listas para sorprender.</p>
            </div>
          </div>
        </div>
      </section>

      <FAQ items={faqItems} title={`Preguntas frecuentes sobre donas decoradas en ${m.nombre}`} />

      {zonasHijas.length > 0 && (
        <section class="local-section local-others">
          <div class="container local-narrow">
            <h2 class="local-others-title">Zonas de {m.nombre} que atendemos</h2>
            <ul class="chips chips-center">
              {zonasHijas.map((z) => (
                <li><a class="chip chip-link" href={rutaMunicipio(z.slug)}>Donas decoradas en {z.nombre}</a></li>
              ))}
            </ul>
          </div>
        </section>
      )}

      {(otrasPaginas.length > 0 || sinPagina.length > 0) && (
        <section class="local-section local-others">
          <div class="container local-narrow">
            <h2 class="local-others-title">También llevamos donas decoradas a</h2>
            <ul class="chips chips-center">
              {otrasPaginas.map((x) => (
                <li><a class="chip chip-link" href={rutaMunicipio(x.slug)}>{x.nombre}</a></li>
              ))}
              {zonasHermanas.map((z) => (
                <li><a class="chip chip-link" href={rutaMunicipio(z.slug)}>{z.nombre}</a></li>
              ))}
              {sinPagina.map((n) => <li class="chip">{n}</li>)}
            </ul>
          </div>
        </section>
      )}

      <section class="local-cta">
        <div class="container local-narrow">
          <h2>¿Listo para pedir tus donas en {m.nombre}?</h2>
          <p>Escríbenos y te cotizamos a tu medida.</p>
          <WhatsAppButton
            number={waNumber}
            message={m.mensajeWhatsApp}
            label="Iniciar mi pedido ahora"
          />
        </div>
      </section>
    </main>

    <SiteFooter whatsappURL={waURL} social={content.social} />
  </div>
</Layout>

<style>
  .local-hero {
    background: linear-gradient(135deg, #FFF0F3 0%, #FFF8F0 50%, #FFF3E8 100%);
    padding: 48px 0 56px;
    text-align: center;
  }
  .local-hero-inner { max-width: 760px; }
  .local-title {
    font-family: var(--ff-display);
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    font-weight: 900;
    line-height: 1.12;
    color: var(--choco);
    margin: 0 0 18px;
  }
  .local-intro {
    font-size: 1.1rem;
    color: var(--gray);
    line-height: 1.7;
    margin: 0 auto 28px;
    max-width: 620px;
  }
  .local-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  .local-gallery { padding-top: 56px; padding-bottom: 56px; }
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .gallery-item {
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    aspect-ratio: 1 / 1;
    background: var(--pink-pale);
  }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gallery-cta { text-align: center; margin-top: 32px; }

  .hero-strip {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 12px;
    margin: 0 auto 26px;
    padding: 0;
  }
  .hero-strip-item {
    flex: 0 0 auto;
    width: 130px;
    height: 130px;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--pink-pale);
  }
  .hero-strip-item img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .local-section { padding: 72px 0; }
  .local-narrow { max-width: 760px; }
  .local-section .section-header { margin-bottom: 36px; }

  .chip-group { margin-bottom: 24px; text-align: center; }
  .chip-title {
    font-weight: 800;
    font-size: .85rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--choco-mid);
    margin: 0 0 12px;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 0;
    padding: 0;
  }
  .chip {
    display: inline-block;
    background: var(--pink-pale);
    color: var(--pink);
    border: 1.5px solid var(--pink-lt);
    border-radius: var(--r-full);
    padding: 8px 18px;
    font-weight: 700;
    font-size: .92rem;
  }
  .chips-soft .chip {
    background: var(--white);
    color: var(--choco);
    border-color: rgba(61, 26, 14, .15);
  }
  .chip-link { text-decoration: none; transition: background .2s, color .2s; }
  .chip-link:hover { background: var(--pink); color: var(--white); }

  .local-note {
    text-align: center;
    font-size: 1.02rem;
    color: var(--gray);
    line-height: 1.7;
    margin: 28px auto 0;
    max-width: 560px;
  }

  .local-ideas { padding: 8px 0 56px; text-align: center; }
  .local-ideas-title {
    font-family: var(--ff-display);
    font-size: clamp(1.4rem, 4vw, 1.8rem);
    color: var(--choco);
    margin: 0 0 14px;
  }
  .local-ideas-text {
    font-size: 1.05rem;
    color: var(--gray);
    line-height: 1.75;
    margin: 0 auto;
    max-width: 640px;
  }

  .local-colegio { background: var(--pink-pale); }
  .colegio-puntos {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .colegio-puntos li {
    position: relative;
    background: var(--white);
    border-radius: var(--r-lg);
    padding: 16px 18px 16px 54px;
    box-shadow: var(--shadow-md);
    color: var(--choco);
    font-weight: 600;
    line-height: 1.55;
  }
  .colegio-puntos li::before {
    content: '🍩';
    position: absolute;
    left: 16px;
    top: 14px;
    font-size: 1.3rem;
  }

  .local-steps-bg { background: var(--pink-pale); }
  .local-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .local-step {
    background: var(--white);
    border-radius: var(--r-lg);
    padding: 32px 24px;
    text-align: center;
    box-shadow: var(--shadow-md);
  }
  .local-step-icon { font-size: 2.6rem; margin-bottom: 12px; }
  .local-step h3 {
    font-family: var(--ff-display);
    font-size: 1.15rem;
    color: var(--choco);
    margin: 0 0 8px;
  }
  .local-step p { font-size: .95rem; color: var(--gray); line-height: 1.6; margin: 0; }

  .local-others { padding: 24px 0 56px; text-align: center; }
  .local-others-title {
    font-family: var(--ff-display);
    font-size: 1.3rem;
    color: var(--choco);
    margin: 0 0 16px;
  }
  .chips-center { justify-content: center; }

  .local-cta {
    background: linear-gradient(135deg, var(--choco) 0%, #5C2A10 100%);
    color: var(--white);
    text-align: center;
    padding: 64px 0;
  }
  .local-cta h2 {
    font-family: var(--ff-display);
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    margin: 0 0 10px;
  }
  .local-cta p { color: rgba(255, 255, 255, .8); margin: 0 0 24px; }

  @media (max-width: 700px) {
    .local-hero { padding: 28px 0 36px; }
    .local-intro { font-size: 1rem; line-height: 1.6; margin-bottom: 20px; }
    .hero-strip {
      justify-content: flex-start;
      gap: 10px;
      margin: 0 -20px 22px;
      padding: 2px 20px 6px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: 20px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .hero-strip::-webkit-scrollbar { display: none; }
    .hero-strip-item { width: 27vw; height: 27vw; max-width: 130px; max-height: 130px; scroll-snap-align: start; }
    .local-section { padding: 52px 0; }
    .local-steps { grid-template-columns: 1fr; }
    .local-gallery { padding-top: 40px; padding-bottom: 40px; }
    .gallery {
      display: flex;
      gap: 12px;
      margin: 0 -20px;
      padding: 4px 20px 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: 20px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .gallery::-webkit-scrollbar { display: none; }
    .gallery-item { flex: 0 0 auto; width: min(72vw, 300px); scroll-snap-align: start; }
  }
</style>
