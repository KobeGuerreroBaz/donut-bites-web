---
export const prerender = false;

const error = Astro.url.searchParams.get('error');
---
<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Panel de administración | Donut Bites.co</title>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,900;1,9..144,400&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <main class="login-wrap">
    <form method="POST" action="/api/admin-login" class="login-card">
      <div class="login-logo">🍩</div>
      <h1>Panel de Donut Bites</h1>
      <p>Ingresa la contraseña para administrar el sitio.</p>
      {error === 'limit' && <p class="login-error">Demasiados intentos. Espera unos minutos y vuelve a intentar.</p>}
      {error && error !== 'limit' && <p class="login-error">Contraseña incorrecta. Intenta de nuevo.</p>}
      <input type="password" name="password" placeholder="Contraseña" required autofocus />
      <button type="submit">Entrar</button>
    </form>
  </main>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Nunito', system-ui, sans-serif;
      background: linear-gradient(135deg, #FFF0F3 0%, #FFF8F0 50%, #FFF3E8 100%);
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
    }
    .login-wrap { width: 100%; max-width: 380px; }
    .login-card {
      background: #fff;
      border-radius: 24px;
      padding: 40px 32px;
      text-align: center;
      box-shadow: 0 20px 60px rgba(61,26,14,.18);
    }
    .login-logo { font-size: 3rem; margin-bottom: 8px; }
    h1 {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 1.5rem; color: #3D1A0E; margin-bottom: 8px;
    }
    p { color: #6B6B6B; font-size: .95rem; margin-bottom: 24px; }
    .login-error { color: #C8446A; font-weight: 700; margin-top: -12px; }
    input {
      width: 100%; padding: 14px 16px; border-radius: 12px;
      border: 1.5px solid #F9B8C7; font-size: 1rem; margin-bottom: 16px;
      font-family: inherit;
    }
    input:focus { outline: none; border-color: #E8496A; }
    button {
      width: 100%; padding: 14px; border: none; border-radius: 999px;
      background: linear-gradient(135deg, #E8496A, #F4736A);
      color: #fff; font-weight: 800; font-size: 1rem; cursor: pointer;
      transition: transform .2s;
    }
    button:hover { transform: translateY(-2px); }
  </style>
</body>
</html>
