<script define:vars={{ seasonPhotos: activeSeason ? activeSeason.images.map((i) => ({ src: i.src, alt: i.alt })) : [] }} is:inline>
  // Menú móvil
  const ham = document.getElementById('hamburger');
  const menu = document.getElementById('mobileMenu');
  ham?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    ham.setAttribute('aria-expanded', String(!!open));
  });

  // Scroll suave con duración y aceleración propias
  // (para cambiar la velocidad: sube o baja 900, 1600 y 0.7)
  let scrollRaf = 0;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  function scrollToTarget(target) {
    cancelAnimationFrame(scrollRaf);
    const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
    const startY = window.scrollY;
    const endY = Math.max(0, target.getBoundingClientRect().top + startY - margin);
    const distance = endY - startY;
    if (reduce || Math.abs(distance) < 2) { window.scrollTo(0, endY); return; }
    const duration = Math.min(1600, Math.max(900, Math.abs(distance) * 0.7));
    const t0 = performance.now();
    const step = (now) => {
      const p = Math.min(1, (now - t0) / duration);
      window.scrollTo(0, startY + distance * ease(p));
      if (p < 1) scrollRaf = requestAnimationFrame(step);
    };
    scrollRaf = requestAnimationFrame(step);
  }

  // Si la persona toca, usa la rueda o el teclado, se detiene la animación
  ['wheel', 'touchstart', 'keydown'].forEach((evt) =>
    window.addEventListener(evt, () => cancelAnimationFrame(scrollRaf), { passive: true })
  );

  document.querySelectorAll('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const target = document.querySelector(a.getAttribute('href'));
      if (menu?.contains(a)) {
        menu.classList.remove('open');
        ham?.setAttribute('aria-expanded', 'false');
      }
      if (target) {
        e.preventDefault();
        requestAnimationFrame(() => scrollToTarget(target));
      }
    });
  });

  // El enlace de WhatsApp del menú solo cierra el menú
  menu?.querySelectorAll('a:not([href^="#"])').forEach((a) => {
    a.addEventListener('click', () => {
      menu.classList.remove('open');
      ham?.setAttribute('aria-expanded', 'false');
    });
  });

  // Aparición al hacer scroll (se omite si el usuario prefiere menos movimiento)
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.style.opacity = '1';
          e.target.style.transform = 'translateY(0)';
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.flavor-card, .step, .occasion-chip').forEach((el) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(30px)';
      el.style.transition = 'opacity .6s ease, transform .6s ease';
      observer.observe(el);
    });
  }

  // Lightbox de temporada
  const photos = seasonPhotos;
  let current = 0;

  const lbOverlay = document.getElementById('lb-overlay');
  const lbImg = document.getElementById('lb-img');
  const lbDots = document.getElementById('lb-dots');

  if (lbDots && photos.length > 1) {
    photos.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'lb-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', 'Foto ' + (i + 1));
      dot.addEventListener('click', () => goTo(i));
      lbDots.appendChild(dot);
    });
  }

  document.querySelectorAll('.season-thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      openLightbox(Number(thumb.dataset.index));
    });
  });
  document.getElementById('lb-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lb-prev')?.addEventListener('click', () => navigate(-1));
  document.getElementById('lb-next')?.addEventListener('click', () => navigate(1));
  lbOverlay?.addEventListener('click', (e) => {
    if (e.target === lbOverlay) closeLightbox();
  });

  function openLightbox(index) {
    current = index;
    renderLb();
    lbOverlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    lbOverlay?.classList.remove('open');
    document.body.style.overflow = '';
  }
  function navigate(dir) {
    current = (current + dir + photos.length) % photos.length;
    renderLb();
  }
  function goTo(index) {
    current = index;
    renderLb();
  }
  function renderLb() {
    if (lbImg && photos[current]) {
      lbImg.src = photos[current].src;
      lbImg.alt = photos[current].alt || '';
    }
    document.querySelectorAll('.lb-dot').forEach((d, i) => {
      d.classList.toggle('active', i === current);
    });
  }
  document.addEventListener('keydown', (e) => {
    if (!lbOverlay?.classList.contains('open')) return;
    if (e.key === 'ArrowRight') navigate(1);
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'Escape') closeLightbox();
  });
</script>
</Layout>
