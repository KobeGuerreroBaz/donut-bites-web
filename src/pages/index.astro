---
import Layout from '../layouts/Layout.astro';
import { getContent, defaultContent } from '../lib/content';
import { ICON } from '../lib/icons';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FAQ from '../components/FAQ.astro';
import { faqPedidos } from '../lib/faq-pedidos';

const env = Astro.locals.runtime?.env;
const content = env ? await getContent(env) : defaultContent;

const whatsappMessage = encodeURIComponent("¡Hola! Vi su página y me gustaría cotizar un pedido de donas 🍩");
const whatsappURL = `https://wa.me/${content.whatsappNumber}?text=${whatsappMessage}`;

const activeSeason = content.activeSeason !== 'ninguna' ? content.seasons[content.activeSeason] : null;
const ogImage = activeSeason?.images[0]?.src ?? content.heroImage.src;

const occasions = [
  { icon: "🎂", label: "Cumpleaños" },
  { icon: "💍", label: "Boda" },
  { icon: "🎄", label: "Navidad" },
  { icon: "💝", label: "San Valentín" },
  { icon: "🦃", label: "Acción de Gracias" },
  { icon: "🎓", label: "Graduación" },
  { icon: "👶", label: "Baby Shower" },
  { icon: "🎃", label: "Halloween" },
];
---

<Layout image={ogImage} phone={content.whatsappNumber}>
  <div class="site-wrapper">

    <!-- ===== HEADER ===== -->
    <SiteHeader whatsappURL={whatsappURL} home />

    {activeSeason && (
      <>
        <!-- ===== BANNER DE TEMPORADA ===== -->
        <section class="banner-season">
          <div class="petal">✨</div>
          <div class="petal">🎉</div>
          <div class="petal">🍩</div>
          <div class="petal">✨</div>
          <div class="petal">🎉</div>
          <div class="petal">🍩</div>

          <div class="banner-season-tag">{activeSeason.tag}</div>
          <p class="banner-season-title" set:html={activeSeason.title} />
          <p class="banner-season-sub">{activeSeason.subtitle}</p>

          <div class="banner-season-gallery" id="seasonGallery">
            {activeSeason.images.slice(0, 6).map((img, i) => (
              <div class="season-thumb" data-index={i}>
                <img src={img.src} alt={img.alt} loading="lazy" />
                <div class="season-overlay"><span>Ver foto</span></div>
              </div>
            ))}
          </div>

          <a href={whatsappURL} class="banner-season-cta" target="_blank" rel="noopener">
            💬 {activeSeason.ctaText}
          </a>
        </section>

        <!-- LIGHTBOX -->
        <div class="lb-overlay" id="lb-overlay">
          <div class="lb-inner">
            <button class="lb-close" id="lb-close" aria-label="Cerrar">✕</button>
            <button class="lb-prev" id="lb-prev" aria-label="Anterior">‹</button>
            <button class="lb-next" id="lb-next" aria-label="Siguiente">›</button>
            <img id="lb-img" alt="" class="lb-img" />
            <div class="lb-dots" id="lb-dots"></div>
          </div>
        </div>
      </>
    )}

    <!-- ===== HERO ===== -->
    <section class="hero" id="inicio">
      <div class="hero-bg">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
        <div class="sprinkle-field" aria-hidden="true">
          <span class="s">🍩</span><span class="s">✨</span><span class="s">🌸</span>
          <span class="s">⭐</span><span class="s">🍩</span><span class="s">💫</span>
          <span class="s">🌟</span><span class="s">🍩</span>
        </div>
      </div>
      <div class="hero-content">
        <div class="hero-badge">📍 Monterrey &amp; Área Metropolitana</div>
        <h1 class="hero-title">
          Donas decoradas<br />
          <em>para tus eventos</em>
        </h1>
        <p class="hero-subtitle">
          Diseños artesanales y personalizados para regalos, cumpleaños y fechas especiales.
          Pedidos por encargo con entrega a domicilio en Monterrey.
        </p>
        <div class="hero-ctas">
          <a href={whatsappURL} class="btn-primary" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON.wa} /></svg>
            Cotizar por WhatsApp
          </a>
          <a href="#sabores" class="btn-secondary">Ver sabores ↓</a>
        </div>
        <div class="hero-stats">
          <div class="stat"><strong>100%</strong><span>Artesanal</span></div>
          <div class="stat-divider"></div>
          <div class="stat"><strong>MTY</strong><span>y Área Metro</span></div>
          <div class="stat-divider"></div>
          <div class="stat"><strong>🍩</strong><span>Por encargo</span></div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="donut-showcase">
          <div class="donut-ring donut-ring-outer"></div>
          <div class="donut-ring donut-ring-mid"></div>
          <picture>
            <source media="(max-width: 900px)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
            <img src={content.heroImage.src} alt={content.heroImage.alt} class="donut-photo-main" width="280" height="280" fetchpriority="high" loading="eager" />
          </picture>
          <div class="floating-tag tag-1">¡Personalizadas!</div>
          <div class="floating-tag tag-2">Entrega en MTY 🛵</div>
        </div>
      </div>
    </section>

    <!-- ===== SABORES ===== -->
    <section class="section-flavors" id="sabores">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">Nuestros Sabores</span>
          <h2>Cada dona, una obra de arte</h2>
          <p>Ingredientes de calidad, decoración artesanal y mucho cariño en cada pieza.</p>
        </div>
        <div class="flavors-grid">
          {content.flavors.map((f) => (
            <div class="flavor-card">
              {f.image ? <img src={f.image.src} alt={f.image.alt} class="flavor-img" loading="lazy" /> : <div class="flavor-emoji">{f.emoji}</div>}
              <h3>{f.name}</h3>
              <p>{f.desc}</p>
            </div>
          ))}
        </div>
        <div class="flavors-cta">
          <p>¿Tienes un sabor o diseño en mente?</p>
          <a href={whatsappURL} class="btn-primary" target="_blank" rel="noopener">Cuéntanos por WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- ===== OCASIONES ===== -->
    <section class="section-occasions" id="ocasiones">
      <div class="container">
        <div class="section-header light">
          <span class="section-eyebrow">Para cada momento</span>
          <h2>Donas personalizadas para cada ocasión</h2>
          <p>Diseños temáticos para cumpleaños, regalos especiales y eventos corporativos.</p>
        </div>
        <div class="occasions-grid">
          {occasions.map((o) => (
            <div class="occasion-chip">
              <span class="occ-icon">{o.icon}</span>
              <span>{o.label}</span>
            </div>
          ))}
        </div>
        <div class="occasions-note">
          <div class="note-card">
            <p>🌟 <strong>Diseños de temporada</strong> — Nuestro catálogo se renueva con cada fecha especial del año. Síguenos en redes para ver los diseños más recientes.</p>
            <div class="social-links">
              <a href={content.social.instagram} target="_blank" rel="noopener" class="social-btn instagram">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON.ig} /></svg>
                Instagram
              </a>
              <a href={content.social.tiktok} target="_blank" rel="noopener" class="social-btn tiktok">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON.tt} /></svg>
                TikTok
              </a>
              <a href={content.social.facebook} target="_blank" rel="noopener" class="social-btn facebook">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON.fb} /></svg>
                Facebook
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== PROCESO ===== -->
    <section class="section-process">
      <div class="container">
        <div class="section-header">
          <span class="section-eyebrow">¿Cómo pedir?</span>
          <h2>Tu pedido en 3 pasos</h2>
        </div>
        <div class="process-steps">
          <div class="step">
            <div class="step-num">1</div>
            <div class="step-icon">💬</div>
            <h3>Escríbenos</h3>
            <p>Cuéntanos por WhatsApp tu idea, cantidad y fecha, y te cotizamos sin compromiso. Pide con 3 días de anticipación.</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step">
            <div class="step-num">2</div>
            <div class="step-icon">🎨</div>
            <h3>Diseñamos</h3>
            <p>Creamos el diseño perfecto para tu ocasión, desde una caja de 6 donas. ¡Tú decides los detalles!</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step">
            <div class="step-num">3</div>
            <div class="step-icon">🍩</div>
            <h3>¡Disfruta!</h3>
            <p>Pasa por tus donas frescas o solicita el servicio a domicilio en cualquier parte del área metropolitana.</p>
          </div>
        </div>
        <div class="process-cta">
          <a href={whatsappURL} class="btn-primary large" target="_blank" rel="noopener">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={ICON.wa} /></svg>
            Iniciar mi pedido ahora
          </a>
        </div>
      </div>
    </section>

    <!-- ===== PREGUNTAS FRECUENTES ===== -->
    <FAQ items={faqPedidos} />

    <!-- ===== NOSOTROS ===== -->
    <section class="section-about" id="nosotros">
      <div class="container about-grid">
        <div class="about-visual">
          <div class="about-donut-wrap">
            <div class="about-emoji">🍩</div>
            <div class="about-bubble b1">Hecho con amor ❤️</div>
            <div class="about-bubble b2">100% artesanal ✨</div>
          </div>
        </div>
        <div class="about-text">
          <span class="section-eyebrow">Nuestra historia</span>
          <h2>Donas que cuentan una historia</h2>
          <p>Somos un emprendimiento familiar en Monterrey. Cada dona es elaborada a mano con ingredientes cuidadosamente seleccionados y decorada con la atención al detalle que solo el amor puede dar.</p>
          <p>Nuestros diseños cambian con las temporadas, porque creemos que cada celebración merece algo especial y único. Desde cumpleaños hasta navidad, tenemos la dona perfecta para ti.</p>
          <div class="about-badges">
            <div class="badge">🏠 Negocio familiar</div>
            <div class="badge">🎨 Diseño artesanal</div>
            <div class="badge">📍 Monterrey y AMM</div>
          </div>
        </div>
      </div>
    </section>

    <SiteFooter whatsappURL={whatsappURL} social={content.social} />
  </div>

<style is:global>
  /* ---- HERO ---- */
  .hero {
    position: relative; overflow: hidden;
    min-height: 90vh;
    display: grid; grid-template-columns: 1fr 1fr; align-items: center;
    gap: 40px; padding: 80px 60px 80px 80px;
    background: linear-gradient(135deg, #FFF0F3 0%, #FFF8F0 50%, #FFF3E8 100%);
  }

  .hero-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .blob {
    position: absolute; border-radius: 50%;
    filter: blur(80px); opacity: .35;
    animation: blobFloat 8s ease-in-out infinite;
  }
  .blob-1 { width: 500px; height: 500px; background: var(--pink-lt); top: -200px; right: -100px; animation-delay: 0s; }
  .blob-2 { width: 350px; height: 350px; background: var(--gold-lt); bottom: -100px; left: 100px; animation-delay: 3s; }
  .blob-3 { width: 250px; height: 250px; background: #FFD6E7; top: 50%; right: 300px; animation-delay: 5s; }

  @keyframes blobFloat {
    0%, 100% { transform: translate(0,0) scale(1); }
    50% { transform: translate(20px, -30px) scale(1.05); }
  }

  .sprinkle-field {
    position: absolute; inset: 0;
    display: flex; flex-wrap: wrap;
    align-items: center; justify-content: space-around;
    opacity: .08; font-size: 3rem;
  }
  .s { animation: spinFloat 12s ease-in-out infinite; }
  .s:nth-child(2) { animation-delay: 1.5s; }
  .s:nth-child(3) { animation-delay: 3s; }
  .s:nth-child(4) { animation-delay: 4.5s; }
  .s:nth-child(5) { animation-delay: 6s; }
  .s:nth-child(6) { animation-delay: 7.5s; }
  .s:nth-child(7) { animation-delay: 9s; }
  .s:nth-child(8) { animation-delay: 10.5s; }

  @keyframes spinFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(180deg); }
  }

  .hero-content { position: relative; z-index: 1; animation: fadeUp .8s ease both; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--white); border: 1.5px solid var(--pink-lt);
    color: var(--pink); font-weight: 700; font-size: .85rem;
    padding: 8px 16px; border-radius: var(--r-full);
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
  }

  .hero-title {
    font-family: var(--ff-display);
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 900; line-height: 1.1;
    color: var(--choco); margin-bottom: 20px;
  }
  .hero-title em {
    font-style: italic; color: var(--pink);
    background: linear-gradient(135deg, var(--pink), #F4736A);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.15rem; color: var(--gray);
    max-width: 480px; margin-bottom: 36px; line-height: 1.7;
  }

  .hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 48px; }

  .hero-stats {
    display: flex; align-items: center; gap: 24px;
    padding: 20px 28px; background: var(--white);
    border-radius: var(--r-lg); box-shadow: var(--shadow-md);
    width: fit-content;
  }
  .stat { text-align: center; }
  .stat strong { display: block; font-family: var(--ff-display); font-size: 1.4rem; font-weight: 900; color: var(--pink); }
  .stat span { font-size: .8rem; color: var(--gray); font-weight: 600; }
  .stat-divider { width: 1px; height: 40px; background: var(--pink-lt); }

  /* HERO VISUAL */
  .hero-visual {
    position: relative; z-index: 1;
    display: flex; justify-content: center; align-items: center;
    animation: fadeUp .8s .3s ease both;
  }

  .donut-showcase { position: relative; width: 360px; height: 360px; }

  .donut-ring {
    position: absolute; border-radius: 50%;
    animation: spin 20s linear infinite;
  }
  .donut-ring-outer {
    inset: 0; border: 3px dashed var(--pink-lt);
  }
  .donut-ring-mid {
    inset: 40px; border: 2px dashed var(--gold-lt);
    animation-direction: reverse; animation-duration: 15s;
  }
  @keyframes spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

  .donut-photo-main {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%,-50%);
    width: 280px; height: 280px;
    border-radius: 50%;
    object-fit: cover;
    border: 8px solid var(--white);
    animation: bounce 3s ease-in-out infinite;
    box-shadow: var(--shadow-lg);
    filter: drop-shadow(0 20px 30px rgba(232,73,106,.3));
  }
  @keyframes bounce {
    0%, 100% { transform: translate(-50%,-50%) rotate(-3deg) scale(1); }
    50% { transform: translate(-50%,-56%) rotate(3deg) scale(1.03); }
  }

  .floating-tag {
    position: absolute;
    background: var(--white); border-radius: var(--r-full);
    padding: 10px 18px; font-weight: 800; font-size: .85rem;
    box-shadow: var(--shadow-md); color: var(--choco);
    animation: floatTag 4s ease-in-out infinite;
  }
  .tag-1 { top: 30px; right: -20px; animation-delay: 0s; }
  .tag-2 { bottom: 60px; left: -30px; animation-delay: 2s; }
  @keyframes floatTag {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* ---- FLAVORS ---- */
  .section-flavors { padding: 100px 0; background: var(--cream); }

  .flavors-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
    margin-bottom: 56px;
  }

  .flavor-card {
    background: var(--white); border-radius: var(--r-lg);
    padding: 36px 28px; text-align: center;
    border: 1.5px solid transparent;
    box-shadow: var(--shadow-sm);
    transition: transform .3s, box-shadow .3s, border-color .3s;
    cursor: default;
  }
  .flavor-card:hover {
    transform: translateY(-8px); box-shadow: var(--shadow-lg);
    border-color: var(--pink-lt);
  }
  .flavor-emoji { font-size: 3.5rem; margin-bottom: 16px; display: block; }
  .flavor-img { width: 100%; height: 200px; object-fit: cover; border-radius: 12px; margin-bottom: 16px; display: block; }
  .flavor-card h3 {
    font-family: var(--ff-display); font-size: 1.2rem; font-weight: 700;
    color: var(--choco); margin-bottom: 10px;
  }
  .flavor-card p { font-size: .95rem; color: var(--gray); line-height: 1.5; }

  .flavors-cta { text-align: center; }
  .flavors-cta p { font-size: 1.1rem; color: var(--gray); margin-bottom: 20px; }

  /* ---- OCCASIONS ---- */
  .section-occasions {
    padding: 100px 0;
    background: linear-gradient(135deg, var(--choco) 0%, #5C2A10 100%);
    position: relative; overflow: hidden;
  }
  .section-occasions::before {
    content: '🍩';
    position: absolute; font-size: 20rem; opacity: .04;
    right: -4rem; top: 50%; transform: translateY(-50%);
    pointer-events: none;
  }

  .occasions-grid {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 16px;
    margin-bottom: 48px;
  }
  .occasion-chip {
    display: flex; align-items: center; gap: 10px;
    background: rgba(255,255,255,.1); border: 1.5px solid rgba(255,255,255,.2);
    color: var(--white); font-weight: 700; font-size: .95rem;
    padding: 12px 22px; border-radius: var(--r-full);
    backdrop-filter: blur(8px);
    transition: background .2s, transform .2s;
  }
  .occasion-chip:hover { background: rgba(255,255,255,.2); transform: scale(1.05); }
  .occ-icon { font-size: 1.4rem; }

  .occasions-note { display: flex; justify-content: center; }
  .note-card {
    background: rgba(255,255,255,.1); border: 1.5px solid rgba(255,255,255,.2);
    border-radius: var(--r-lg); padding: 28px 36px;
    backdrop-filter: blur(12px); max-width: 600px; text-align: center;
    color: var(--white);
  }
  .note-card p { font-size: 1rem; line-height: 1.6; margin-bottom: 20px; }

  .social-links { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .social-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 20px; border-radius: var(--r-full);
    font-weight: 700; font-size: .9rem; text-decoration: none;
    transition: transform .2s, opacity .2s;
  }
  .social-btn:hover { transform: translateY(-2px); opacity: .9; }
  .social-btn.instagram { background: linear-gradient(135deg, #E1306C, #833AB4); color: var(--white); }
  .social-btn.tiktok    { background: var(--choco); color: var(--white); }
  .social-btn.facebook  { background: #1877F2; color: var(--white); }

  /* ---- PROCESS ---- */
  .section-process {
    padding: 100px 0;
    background: var(--pink-pale);
  }
  .process-steps {
    display: flex; align-items: center; justify-content: center;
    gap: 16px; flex-wrap: wrap; margin-bottom: 56px;
  }
  .step {
    background: var(--white); border-radius: var(--r-lg);
    padding: 40px 32px; text-align: center;
    flex: 1; min-width: 220px; max-width: 280px;
    box-shadow: var(--shadow-md);
    position: relative; overflow: hidden;
  }
  .step::before {
    content: ''; position: absolute;
    top: 0; left: 0; right: 0; height: 4px;
    background: linear-gradient(90deg, var(--pink), var(--gold));
  }
  .step-num {
    position: absolute; top: 16px; right: 20px;
    font-family: var(--ff-display); font-size: 3rem; font-weight: 900;
    color: var(--pink-pale); line-height: 1;
  }
  .step-icon { font-size: 3rem; margin-bottom: 16px; display: block; }
  .step h3 { font-family: var(--ff-display); font-size: 1.2rem; font-weight: 700; color: var(--choco); margin-bottom: 10px; }
  .step p { font-size: .95rem; color: var(--gray); }

  .step-arrow { font-size: 1.8rem; color: var(--pink-lt); flex-shrink: 0; }
  .process-cta { text-align: center; }

  /* ---- ABOUT ---- */
  .section-about { padding: 100px 0; background: var(--cream); }
  .about-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 80px; align-items: center;
  }
  .about-visual { display: flex; justify-content: center; }
  .about-donut-wrap { position: relative; width: 300px; height: 300px; }
  .about-emoji {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: 8rem;
    animation: bounce 4s ease-in-out infinite;
    filter: drop-shadow(0 20px 30px rgba(232,73,106,.25));
  }
  .about-bubble {
    position: absolute; background: var(--white);
    border-radius: var(--r-full); padding: 10px 18px;
    font-weight: 700; font-size: .85rem; color: var(--choco);
    box-shadow: var(--shadow-md);
    animation: floatTag 4s ease-in-out infinite;
  }
  .b1 { top: 10px; right: -40px; animation-delay: 0s; }
  .b2 { bottom: 30px; left: -30px; animation-delay: 2s; }

  .about-text .section-eyebrow { display: inline-block; margin-bottom: 16px; }
  .about-text h2 {
    font-family: var(--ff-display); font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 900; color: var(--choco); margin-bottom: 20px; line-height: 1.2;
  }
  .about-text p { font-size: 1rem; color: var(--gray); margin-bottom: 16px; line-height: 1.7; }

  .about-badges { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .badge {
    background: var(--pink-pale); color: var(--pink);
    border: 1.5px solid var(--pink-lt);
    border-radius: var(--r-full); padding: 8px 18px;
    font-weight: 700; font-size: .9rem;
  }

  /* ---- BANNER DE TEMPORADA ---- */
  .banner-season {
    background: linear-gradient(135deg, #FAE8EE 0%, #FFF0F5 50%, #FAE8EE 100%);
    border-bottom: 1.5px solid #F2C4D0;
    padding: 48px 32px 52px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .petal {
    position: absolute;
    font-size: 28px;
    opacity: .18;
    animation: petalFloat 6s ease-in-out infinite;
    pointer-events: none;
  }
  .petal:nth-child(1) { top: 10%; left: 5%;   animation-delay: 0s;   font-size: 22px; }
  .petal:nth-child(2) { top: 20%; left: 88%;  animation-delay: 1s;   font-size: 32px; }
  .petal:nth-child(3) { top: 65%; left: 3%;   animation-delay: 2s;   font-size: 18px; }
  .petal:nth-child(4) { top: 70%; left: 92%;  animation-delay: .5s;  font-size: 26px; }
  .petal:nth-child(5) { top: 40%; left: 95%;  animation-delay: 3s;   font-size: 16px; }
  .petal:nth-child(6) { top: 5%;  left: 50%;  animation-delay: 1.5s; font-size: 20px; }
  @keyframes petalFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%       { transform: translateY(-12px) rotate(8deg); }
  }
  .banner-season-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #C8446A;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .banner-season-title {
    font-family: var(--ff-display);
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 400;
    color: var(--choco);
    line-height: 1.15;
    margin-bottom: 10px;
  }
  .banner-season-title em { color: #C8446A; font-style: italic; }
  .banner-season-sub {
    font-size: 15px;
    color: var(--gray);
    margin-bottom: 28px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .banner-season-gallery {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .season-thumb {
    width: 200px;
    height: 200px;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    position: relative;
    box-shadow: 0 8px 32px rgba(200,68,106,.18);
    border: 3px solid #fff;
    transition: transform .25s, box-shadow .25s;
  }
  .season-thumb:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 16px 48px rgba(200,68,106,.28);
  }
  .season-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s;
  }
  .season-thumb:hover img { transform: scale(1.06); }
  .season-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(200,68,106,.5) 0%, transparent 60%);
    opacity: 0;
    transition: opacity .25s;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 14px;
  }
  .season-thumb:hover .season-overlay { opacity: 1; }
  .season-overlay span { color: #fff; font-size: 12px; font-weight: 700; }
  .banner-season-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #C8446A;
    color: #fff;
    padding: 13px 28px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(200,68,106,.35);
    transition: all .2s;
  }
  .banner-season-cta:hover { background: #a8345a; transform: translateY(-2px); }

  /* ---- LIGHTBOX ---- */
  .lb-overlay {
    position: fixed;
    inset: 0;
    background: rgba(20,5,10,.92);
    z-index: 500;
    display: none;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
    padding: 20px;
  }
  .lb-overlay.open { display: flex; animation: fadeIn .3s ease; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  .lb-inner {
    position: relative;
    max-width: 520px;
    width: 100%;
  }
  .lb-img {
    width: 100%;
    border-radius: 24px;
    display: block;
    box-shadow: 0 24px 80px rgba(0,0,0,.5);
    max-height: 80vh;
    object-fit: contain;
    animation: fadeIn .3s ease;
  }
  .lb-close {
    position: absolute;
    top: -16px; right: -16px;
    width: 36px; height: 36px;
    border-radius: 50%;
    background: #C8446A;
    color: #fff;
    font-size: 16px;
    cursor: pointer;
    border: none;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 12px rgba(200,68,106,.4);
    transition: all .2s;
    z-index: 10;
  }
  .lb-close:hover { background: #a8345a; transform: scale(1.1); }
  .lb-prev, .lb-next {
    position: absolute;
    top: 50%; transform: translateY(-50%);
    width: 44px; height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,.15);
    border: 1.5px solid rgba(255,255,255,.25);
    color: #fff;
    font-size: 22px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all .2s;
  }
  .lb-prev { left: -56px; }
  .lb-next { right: -56px; }
  .lb-prev:hover, .lb-next:hover { background: rgba(255,255,255,.3); }
  .lb-dots {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 16px;
  }
  .lb-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,.3);
    cursor: pointer;
    border: none;
    transition: all .2s;
  }
  .lb-dot.active { background: #F2C4D0; transform: scale(1.3); }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr; text-align: center;
      padding: 60px 32px;
    }
    .hero-subtitle { margin-left: auto; margin-right: auto; }
    .hero-ctas { justify-content: center; }
    .hero-stats { margin: 0 auto; }
    .hero-visual { display: none; }
    .flavors-grid { grid-template-columns: repeat(2, 1fr); }
    .about-grid { grid-template-columns: 1fr; gap: 40px; }
    .about-visual { display: none; }
  }

  @media (max-width: 600px) {
    .flavors-grid { grid-template-columns: 1fr; }
    .process-steps { flex-direction: column; }
    .step-arrow { transform: rotate(90deg); }
    .step { max-width: 100%; }
    .hero-stats { margin-bottom: 20px; }

    /* Banner de temporada en móvil: fotos en carrusel que se desliza de lado */
    .banner-season { padding: 32px 20px 36px; }
    .banner-season-sub { margin-bottom: 20px; }
    .banner-season-gallery {
      flex-wrap: nowrap; justify-content: flex-start; gap: 12px;
      margin: 0 -20px 24px; padding: 4px 20px 14px;
      overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: 20px;
      -webkit-overflow-scrolling: touch; scrollbar-width: none;
    }
    .banner-season-gallery::-webkit-scrollbar { display: none; }
    .season-thumb {
      flex: 0 0 auto; scroll-snap-align: start;
      width: min(62vw, 250px); height: min(62vw, 250px);
    }

    /* Lightbox en móvil: botones dentro de la pantalla */
    .lb-prev { left: 8px; }
    .lb-next { right: 8px; }
    .lb-prev, .lb-next { background: rgba(0,0,0,.4); }
    .lb-close { top: 8px; right: 8px; }
  }
</style>

<script define:vars={{ seasonPhotos: activeSeason ? activeSeason.images.map((i) => ({ src: i.src, alt: i.alt })) : [] }} is:inline>
  // (El menú móvil vive ahora en SiteHeader.astro)

  // Scroll suave con duración y aceleración propias
  // (para cambiar la velocidad: sube o baja 900, 1600 y 0.7)
  let scrollRaf = 0;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  function scrollToTarget(target) {
    cancelAnimationFrame(scrollRaf);
    const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
    const startY = window.scrollY;
    const endY = Math.max(0, target.getBoundingClientRect().top + startY - margin);
    const distance = endY - startY;
    if (reduce || Math.abs(distance) < 2) { window.scrollTo(0, endY); return; }
    const duration = Math.min(1600, Math.max(900, Math.abs(distance) * 0.7));
    const t0 = performance.now();
    const step = (now) => {
      const p = Math.min(1, (now - t0) / duration);
      window.scrollTo(0, startY + distance * ease(p));
      if (p < 1) scrollRaf = requestAnimationFrame(step);
    };
    scrollRaf = requestAnimationFrame(step);
  }

  // Si la persona toca, usa la rueda o el teclado, se detiene la animación
  ['wheel', 'touchstart', 'keydown'].forEach((evt) =>
    window.addEventListener(evt, () => cancelAnimationFrame(scrollRaf), { passive: true })
  );

  document.querySelectorAll('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const target = document.querySelector(a.getAttribute('href'));
      if (target) {
        e.preventDefault();
        requestAnimationFrame(() => scrollToTarget(target));
      }
    });
  });

  // Aparición al hacer scroll (se omite si el usuario prefiere menos movimiento)
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.style.opacity = '1';
          e.target.style.transform = 'translateY(0)';
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.flavor-card, .step, .occasion-chip').forEach((el) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(30px)';
      el.style.transition = 'opacity .6s ease, transform .6s ease';
      observer.observe(el);
    });
  }

  // Lightbox de temporada
  const photos = seasonPhotos;
  let current = 0;

  const lbOverlay = document.getElementById('lb-overlay');
  const lbImg = document.getElementById('lb-img');
  const lbDots = document.getElementById('lb-dots');

  if (lbDots && photos.length > 1) {
    photos.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'lb-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', 'Foto ' + (i + 1));
      dot.addEventListener('click', () => goTo(i));
      lbDots.appendChild(dot);
    });
  }

  document.querySelectorAll('.season-thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      openLightbox(Number(thumb.dataset.index));
    });
  });
  document.getElementById('lb-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lb-prev')?.addEventListener('click', () => navigate(-1));
  document.getElementById('lb-next')?.addEventListener('click', () => navigate(1));
  lbOverlay?.addEventListener('click', (e) => {
    if (e.target === lbOverlay) closeLightbox();
  });

  function openLightbox(index) {
    current = index;
    renderLb();
    lbOverlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    lbOverlay?.classList.remove('open');
    document.body.style.overflow = '';
  }
  function navigate(dir) {
    current = (current + dir + photos.length) % photos.length;
    renderLb();
  }
  function goTo(index) {
    current = index;
    renderLb();
  }
  function renderLb() {
    if (lbImg && photos[current]) {
      lbImg.src = photos[current].src;
      lbImg.alt = photos[current].alt || '';
    }
    document.querySelectorAll('.lb-dot').forEach((d, i) => {
      d.classList.toggle('active', i === current);
    });
  }
  document.addEventListener('keydown', (e) => {
    if (!lbOverlay?.classList.contains('open')) return;
    if (e.key === 'ArrowRight') navigate(1);
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'Escape') closeLightbox();
  });
</script>
</Layout>
